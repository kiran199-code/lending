# Copy to .env (git-ignored) and fill in. Credentials are read from the environment only - never from a properties file.
E2E_PROFILE=sit
E2E_LENDING_BASE_URL=https://lending.sit.example.internal
E2E_BATCH_BASE_URL=https://batch.sit.example.internal
E2E_ADMIN_BASE_URL=https://admin.sit.example.internal
E2E_BATCH_USERNAME=batch-admin
E2E_BATCH_PASSWORD=
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=
# optional: pin hosts so a typo can never point the suite somewhere unintended
# E2E_GUARD_ALLOWED_HOST_PATTERNS=\.sit\.example\.internal$
# E2E_ACCOUNTS=20
